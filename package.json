{
  "name": "enterprise-mcp-kit",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": { "node": ">=18" },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "validate": "npm run typecheck && npm test",
    "mcp:stdio": "npm run build && node dist/src/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  }
}
