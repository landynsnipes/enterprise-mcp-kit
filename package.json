{
  "name": "enterprise-mcp-kit",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "validate": "npm run typecheck && npm test && npm run validate:distribution",
    "validate:distribution": "node scripts/validate-enterprise-distribution.mjs",
    "mcp:stdio": "npm run build && node dist/src/server.js",
    "governance:http": "npm run build && node dist/src/governance-http-server.js",
    "demo:env": "bash demo/netbox-lab/scripts/generate-env.sh",
    "demo:config": "test -f demo/netbox-lab/.env && docker compose --project-name enterprise-mcp-kit-demo --env-file demo/netbox-lab/.env -f demo/netbox-lab/compose.yaml config -q",
    "demo:up": "npm run demo:config && docker compose --project-name enterprise-mcp-kit-demo --env-file demo/netbox-lab/.env -f demo/netbox-lab/compose.yaml up -d",
    "demo:identity:up": "bash demo/netbox-lab/scripts/ensure-keycloak-env.sh && docker compose --project-name enterprise-mcp-kit-demo --env-file demo/netbox-lab/.env -f demo/netbox-lab/compose.yaml up -d keycloak",
    "demo:identity:verify": "bash demo/netbox-lab/scripts/verify-governance-identity.sh",
    "demo:write:verify": "bash demo/netbox-lab/scripts/verify-governance-write.sh",
    "demo:write:verify:software": "bash demo/netbox-lab/scripts/verify-software-version-write.sh",
    "demo:write:verify:site": "bash demo/netbox-lab/scripts/verify-site-information-write.sh",
    "demo:provision:verify": "bash demo/netbox-lab/scripts/verify-site-provisioning.sh",
    "demo:provision:verify:governed": "bash demo/netbox-lab/scripts/verify-governed-site-provisioning.sh",
    "demo:governance:mcp:verify": "bash demo/netbox-lab/scripts/verify-governance-mcp.sh",
    "demo:governance:postgres:verify": "bash demo/netbox-lab/scripts/verify-postgres-governance.sh",
    "demo:provision:verify:tenant-boundary": "bash demo/netbox-lab/scripts/verify-provisioning-tenant-boundary.sh",
    "demo:status": "docker compose --project-name enterprise-mcp-kit-demo --env-file demo/netbox-lab/.env -f demo/netbox-lab/compose.yaml ps",
    "demo:down": "docker compose --project-name enterprise-mcp-kit-demo --env-file demo/netbox-lab/.env -f demo/netbox-lab/compose.yaml down",
    "demo:seed": "bash demo/netbox-lab/scripts/seed.sh",
    "demo:verify": "bash demo/netbox-lab/scripts/verify-live.sh",
    "demo:seed:showcase": "bash demo/netbox-lab/scripts/seed-showcase.sh",
    "demo:verify:showcase": "bash demo/netbox-lab/scripts/verify-showcase.sh",
    "demo:recovery:verify": "bash demo/netbox-lab/scripts/verify-recovery.sh",
    "demo:upgrade:verify": "bash demo/netbox-lab/scripts/verify-upgrade-rollback.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.15.5",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "pg": "8.16.3",
    "zod": "4.4.3"
  }
}
