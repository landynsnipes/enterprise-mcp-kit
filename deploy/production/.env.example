# Copy to a root-owned file outside this repository, then replace every value.
# Do not commit the resulting file or place it in a shared home directory.
NETBOX_PUBLIC_HOST=netbox.example.com
MCP_PUBLIC_HOST=mcp.example.com
ACME_EMAIL=ops@example.com

NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox
NETBOX_DB_PASSWORD=replace-with-a-unique-secret
NETBOX_REDIS_PASSWORD=replace-with-a-unique-secret
NETBOX_CACHE_PASSWORD=replace-with-a-unique-secret
NETBOX_SECRET_KEY=replace-with-a-long-random-netbox-secret
NETBOX_SUPERUSER_NAME=replace-on-first-install
NETBOX_SUPERUSER_EMAIL=ops@example.com
NETBOX_SUPERUSER_PASSWORD=replace-with-a-temporary-bootstrap-secret

GOVERNANCE_DB_PASSWORD=replace-with-a-unique-secret
GOVERNANCE_OIDC_ISSUER=https://identity.example.com/realms/enterprise
GOVERNANCE_OIDC_JWKS_URL=https://identity.example.com/realms/enterprise/protocol/openid-connect/certs
GOVERNANCE_OIDC_AUDIENCE=enterprise-mcp-kit
GOVERNANCE_MCP_ALLOWED_HOSTS=mcp.example.com
GOVERNANCE_MCP_REQUESTS_PER_MINUTE=60

# Keep both flags false until the OIDC role mapping, least-privilege NetBox
# accounts, and a non-production acceptance test have been approved.
GOVERNANCE_EXECUTION_ENABLED=false
GOVERNANCE_PROVISIONING_ENABLED=false
NETBOX_WRITE_BASE_URL=
NETBOX_WRITE_TOKEN=
NETBOX_PROVISION_BASE_URL=
NETBOX_PROVISION_TOKEN=
NETBOX_PROVISION_TIMEOUT_MS=5000

# Before a production rollout, set this to an image digest built by your CI.
# The local default exists only for build-and-validate on the deployment host.
GOVERNANCE_IMAGE=registry.example.com/enterprise-mcp-kit-governance@sha256:replace-with-your-release-digest
