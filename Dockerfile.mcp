# syntax=docker/dockerfile:1.7
FROM docker.io/library/node@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM docker.io/library/node@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS runtime
ENV NODE_ENV=production
ARG MCP_CONNECTOR=netbox
ENV MCP_CONNECTOR=${MCP_CONNECTOR}
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
    && npm cache clean --force \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --from=build /app/dist ./dist
COPY scripts/mcp-entrypoint.mjs ./scripts/mcp-entrypoint.mjs
USER node
ENTRYPOINT ["node", "scripts/mcp-entrypoint.mjs"]
