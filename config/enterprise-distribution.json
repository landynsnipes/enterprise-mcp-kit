      "version": "1.1.7",
      "license": "Apache-2.0",
      "source": "https://github.com/DanSheps/netbox-lifecycle",
      "purpose": "hardware EOL/EOS, licenses, and support contracts",
      "status": "not-installed-not-supported",
      "admissionRequirements": [
        "NetBox 4.6.5 compatibility test",
        "migration test",
        "seed and API test",
        "backup and restore test",
        "upgrade and rollback test",
        "removal and data export test",
        "license and dependency scan"
      ]
    }
  ],
  "releaseGates": [
    "all included component licenses are approved",
    "all container images are pinned by digest for a production release",
    "all supported plugins pass their admission requirements",
    "backup and restore are exercised against the release candidate",
    "upgrade and rollback are exercised from the previous supported release",
    "live MCP tests pass with least-privilege credentials",
    "the production boundary is documented without turnkey claims"
  ]
