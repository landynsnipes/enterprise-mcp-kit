GOVERNANCE_OIDC_ISSUER=https://identity.example/realms/enterprise
GOVERNANCE_OIDC_JWKS_URL=https://identity.example/realms/enterprise/protocol/openid-connect/certs
GOVERNANCE_OIDC_AUDIENCE=enterprise-mcp-kit
GOVERNANCE_STORAGE_BACKEND=postgres
GOVERNANCE_DATABASE_URL=postgresql://governance:replace-from-secret-store@postgres/governance
GOVERNANCE_HTTP_HOST=127.0.0.1
GOVERNANCE_HTTP_PORT=8787
GOVERNANCE_MCP_ALLOWED_HOSTS=mcp.example:443
GOVERNANCE_MCP_REQUESTS_PER_MINUTE=60
GOVERNANCE_EXECUTION_ENABLED=false
GOVERNANCE_PROVISIONING_ENABLED=false
# When execution is approved, inject NETBOX_WRITE_BASE_URL and
# NETBOX_WRITE_TOKEN from a separate bounded service identity.
# When provisioning is approved, inject NETBOX_PROVISION_BASE_URL,
# NETBOX_PROVISION_TOKEN, and NETBOX_PROVISION_TIMEOUT_MS from the tenant's
# dedicated provisioner identity.
