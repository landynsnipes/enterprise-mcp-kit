[Unit]
Description=Open Enterprise AIOps native two-site WireGuard lab
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/sh /opt/enterprise-mcp-kit/demo/wireguard-netns/setup.sh
ExecStop=/usr/bin/sh /opt/enterprise-mcp-kit/demo/wireguard-netns/down.sh

[Install]
WantedBy=multi-user.target
